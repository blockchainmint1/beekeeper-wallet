{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": [
    "src/styles.css"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/generate-capacitor-index.mjs",
    "build:dev": "vite build --mode development && bun scripts/generate-capacitor-index.mjs",
    "build:ios": "VITE_DISABLE_EXCHANGE=true vite build && bun scripts/generate-capacitor-index.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#0b0f14' --iconBackgroundColorDark '#0b0f14' --splashBackgroundColor '#0b0f14' --splashBackgroundColorDark '#0b0f14'",
    "cap:sync": "bun run build && bunx cap sync",
    "ios:harden": "bun scripts/harden-ios-native.mjs",
    "ios:setup": "bun install && bun run build:ios && (test -d ios || bunx cap add ios) && bun run cap:assets && bunx cap sync ios && bun run ios:harden && bunx cap open ios",
    "ios:reset": "rm -rf ios && bun run build:ios && bunx cap add ios && bun run cap:assets && bunx cap sync ios && bun run ios:harden && bunx cap open ios",
    "android:patch": "bun scripts/patch-android-manifest.mjs && bun scripts/patch-android-icons.mjs",
    "android:icons": "bun scripts/patch-android-icons.mjs",
    "android:setup": "bun install && bun run build && (test -d android || bunx cap add android) && bun run cap:assets && bunx cap sync android && bun run android:patch && bunx cap open android",
    "android:reset": "rm -rf android && bun run build && bunx cap add android && bun run cap:assets && bunx cap sync android && bun run android:patch && bunx cap open android",
    "android:apk": "bun run build && (test -d android || bunx cap add android) && bunx cap sync android && bun run android:patch && cd android && ./gradlew assembleDebug"
  },
